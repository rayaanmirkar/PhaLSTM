import pandas as pd
import numpy as np

training_df = pd.read_csv('building_data/final.csv')
training_df = training_df.dropna(subset=['protein_sentence', 'Binary lifestyle'])
x_training = training_df['protein_sentence'].astype(str).values

lengths = np.array([len(seq) for seq in x_training])

print("all sequence lengths:")
print("Min:", lengths.min())
print("Median:", np.median(lengths))
print("90th percentile:", np.percentile(lengths, 90))
print("95th percentile:", np.percentile(lengths, 95))
print("99th percentile:", np.percentile(lengths, 99))
print("Max:", lengths.max())



